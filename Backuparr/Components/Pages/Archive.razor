@page "/archive"
@attribute [StreamRendering]
@using Backuparr.Interfaces
@inject IConstants _constants
@inject IArchiveService _archiveService
@inject NavigationManager _navi

<PageTitle>Backups</PageTitle>

<h1>Backups</h1>

@if (backups == null) 
 {
     <p><em>Loading...</em></p> 
 } 
else
{
    <table class="table">
        <thead>
            <tr>
                <th aria-label="Archive Name">Name</th>
                <th aria-label="Archive Date">Date</th>
                <th aria-label="Archive Size">Size</th>
                <th>Download</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var backup in backups)
             { 
                <tr>
                    <td>@backup.Name</td>
                    <td>@backup.CreationTime</td>
                    <td>@backup.Length B</td>
                    <td>
                         <button class="btn btn-primary btn-sm" @onclick="() => onClick(backup.Name)"> 
                            <i class="fa-solid fa-download"></i> 
                        </button> 
                    </td>
                </tr> 
             } 
        </tbody>
    </table>
}

@code {
    private IEnumerable<FileInfo> backups;
    protected override async Task OnInitializedAsync()
    {
        backups = _archiveService.GetBackups();
    }

    private async Task onClick(string filename)
    {
        _navi.NavigateTo($"api/archive/download/{filename}", true);
    }
}
