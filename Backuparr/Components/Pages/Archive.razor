@page "/archive"
@attribute [StreamRendering]
@using Backuparr.Components.Layout
@using Backuparr.Interfaces
@inject IConstants _constants
@inject IArchiveService _archiveService
@inject NavigationManager _navi

<PageTitle>Backups</PageTitle>

<h1>Backups</h1>

@if (backups == null) 
{
    <p><em>Loading...</em></p> 
} 
else
{
    <table class="table">
        <thead>
            <tr>
                <th aria-label="Archive Name">Name</th>
                <th aria-label="Archive Date">Date</th>
                <th aria-label="Archive Size">Size</th>
                <th>Download</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var backup in backups)
            { 
                <tr>
                    <td>@backup.Name</td>
                    <td>@backup.CreationTime</td>
                    <td>@backup.Length B</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => onClick(backup.Name)"> 
                            <i class="fa-solid fa-download"></i> 
                        </button> 
                    </td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteArchive(backup.Name)">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </td>
                </tr> 
            } 
        </tbody>
    </table>
}

<ConfirmationDialog @ref="ModalDialog" />

@code {
    private IEnumerable<FileInfo> backups;
    private ConfirmationDialog ModalDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {
        backups = _archiveService.GetBackups();
    }

    private async Task onClick(string filename)
    {
        _navi.NavigateTo($"api/archive/download/{filename}", true);
    }

    private async Task DeleteArchive(string filename)
    {

        var confirmed = await ModalDialog.Show("Delete archive", $"Are you sure you want to delete '{filename}'?");
        if (confirmed)
        {
            _archiveService.DeleteArchive(filename);
            backups = _archiveService.GetBackups();
            //StateHasChanged();
        }
    }   
}
